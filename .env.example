# LLM provider — "anthropic" (default) or "groq"
LLM_PROVIDER=anthropic

# Anthropic (Claude) — tool-use + cache_control path
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (OpenAI-compatible endpoint) — response_format json_object path
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Brand voice — drives every generated post
BRAND_NAME=OmniPost Studio
BRAND_TONE=clear, confident, friendly-expert, no hype, no clichés
BRAND_AUDIENCE=small-business owners and indie founders evaluating AI tooling
BRAND_CTA=Reply with your biggest content bottleneck — happy to brainstorm.
BRAND_DO=specific examples, concrete numbers, plain English, one strong claim per post
BRAND_DONT=in today's fast-paced world, game-changer, leverage synergies, AI revolution
BRAND_LANGUAGE=en-US

# Paths
INPUT_PATH=data/source.md
OUTPUT_DIR=data/out
CACHE_DIR=data/cache

# Scheduling
SCHEDULE_TIMEZONE=America/New_York
SCHEDULE_DAYS=7
